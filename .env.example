# All optional. With none set, the pipeline runs in DRY-RUN (local render, no publish).

# --- Content generation (LLM) ---
# If unset, generate.mjs uses the built-in template writer.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Voice (TTS) ---
# 'say' uses the macOS built-in voice (free, local). Or provide an API.
TTS_PROVIDER=say
TTS_VOICE=Samantha
# ELEVENLABS_API_KEY=
# FISH_AUDIO_API_KEY=

# --- Avatar / video providers (optional; local ffmpeg is the fallback) ---
# HEYGEN_API_KEY=
# DID_API_KEY=
# REPLICATE_API_TOKEN=

# --- Publishing ---
# Recommended: a Postiz instance connected to your Instagram account.
POSTIZ_URL=
POSTIZ_API_KEY=
# Or the official Instagram Graph API (Creator/Business account).
IG_ACCESS_TOKEN=
IG_USER_ID=
# Set to 1 to actually publish. Otherwise every publish is a dry run.
PUBLISH=false
